# ذخیره نسخه اصلی فیلتر چت قبل از اینکه پلاگین Fingilish اون رو patch کنه
try:
    import bascenev1 as _bs_orig_mod
    _BMS_ORIGINAL_CHAT_FILTER = _bs_orig_mod._filterChatMessages
except Exception:
    _BMS_ORIGINAL_CHAT_FILTER = None


# ba_meta export babase.Plugin
class BMSSquadAnnouncerPlugin(babase.Plugin):
    """ارسال خودکار پیام تبلیغاتی هنگام ورود به مپ بازی."""

    ANNOUNCE_MESSAGE = '💛مرجع دانلود خفن ترین مود های بازی💥Bms_Squad🌹'
    JOIN_DELAY = 3.0       # ۳ ثانیه بعد از ورود
    REPEAT_DELAY = 300.0   # هر ۵ دقیقه

    def on_app_running(self):
        try:
            import bascenev1 as bs
            self.bs = bs
        except ImportError:
            self.bs = None
            return

        self._in_game = False
        self._announce_gen = 0

        # شروع پایش ورود/خروج از مپ
        babase.apptimer(1.0, self._poll_activity)

    # ---------- تشخیص ورود به مپ ----------
    def _poll_activity(self):
        try:
            activity = self.bs.get_foreground_host_activity()
            is_game = self._is_game_activity(activity)

            if is_game and not self._in_game:
                self._in_game = True
                self._start_announcements()
            elif not is_game and self._in_game:
                self._in_game = False
                self._stop_announcements()
        except Exception:
            pass
        finally:
            babase.apptimer(1.0, self._poll_activity)

    def _is_game_activity(self, activity):
        if activity is None:
            return False
        try:
            if getattr(activity, 'is_main_game_activity', False):
                return True
            players = getattr(activity, 'players', None)
            if players is not None:
                try:
                    if len(players) > 0:

return True
                except Exception:
                    pass
            mod = (activity.class.module or '').lower()
            if 'game' in mod and 'menu' not in mod and 'ui' not in mod:
                return True
        except Exception:
            pass
        return False

    # ---------- زمان‌بندی ارسال ----------
    def _start_announcements(self):
        self._announce_gen += 1
        gen = self._announce_gen

        def first_send():
            if self._announce_gen != gen or not self._in_game:
                return
            self._send_message()

            def repeat_send():
                if self._announce_gen != gen or not self._in_game:
                    return
                self._send_message()
                babase.apptimer(self.REPEAT_DELAY, repeat_send)

            babase.apptimer(self.REPEAT_DELAY, repeat_send)

        babase.apptimer(self.JOIN_DELAY, first_send)

    def _stop_announcements(self):
        self._announce_gen += 1

    # ---------- ارسال پیام ----------
    def _send_message(self):
        msg = self.ANNOUNCE_MESSAGE

        # موقتاً فیلتر Fingilish رو غیرفعال کن تا پیام فارسی خراب نشه
        bypassed = False
        saved_filter = None
        try:
            current = getattr(self.bs, '_filterChatMessages', None)
            if (_BMS_ORIGINAL_CHAT_FILTER is not None
                    and current is not None
                    and current is not _BMS_ORIGINAL_CHAT_FILTER):
                saved_filter = current
                self.bs._filterChatMessages = _BMS_ORIGINAL_CHAT_FILTER
                bypassed = True
        except Exception:
            pass

        try:
            self._do_send(msg)
        finally:
            if bypassed and saved_filter is not None:
                try:
                    self.bs._filterChatMessages = saved_filter
                except Exception:
                    pass

    def _do_send(self, msg):
        # روش ۱: ارسال از طریق سشن (کلاینت یا هاست)
        for getter_name in ('get_client_session', 'get_foreground_host_session'):
            try:
                getter = getattr(self.bs, getter_name, None)
                if not getter:
                    continue
                session = getter()
                if session is None:
                    continue
                for m_name in ('chat_message', '_send_chat_message', 'send_chat_message'):
                    m = getattr(session, m_name, None)
                    if callable(m):
                        try:
                            m(msg)
                            return
                        except Exception:
                            continue
            except Exception:
                continue

        # روش ۲: نمایش محلی به‌عنوان fallback
        try:
            self.bs.chatmessage(msg)
        except Exception:
            pass