import babase
import bauiv1 as bui

plugin_name = 'BMS Fingilish'
version = '21.0.0'

CONFIG_KEY = 'BMSFingilish_Settings'

FINGILISH_MAP = {
    'آ': 'a', 'ا': 'a', 'ب': 'b', 'پ': 'p', 'ت': 't', 'ث': 's',
    'ج': 'j', 'چ': 'ch', 'ح': 'h', 'خ': 'kh', 'د': 'd', 'ذ': 'z',
    'ر': 'r', 'ز': 'z', 'ژ': 'zh', 'س': 's', 'ش': 'sh', 'ص': 's',
    'ض': 'z', 'ط': 't', 'ظ': 'z', 'ع': 'a', 'غ': 'gh', 'ف': 'f',
    'ق': 'gh', 'ک': 'k', 'گ': 'g', 'ل': 'l', 'م': 'm', 'ن': 'n',
    'و': 'v', 'ه': 'h', 'ی': 'y', 'ء': '', 'ئ': 'y', 'أ': 'a',
    'إ': 'e', 'ؤ': 'o', '\u200c': '',
}

def to_fingilish(text):
    try:
        return ''.join(FINGILISH_MAP.get(c, c) for c in text)
    except Exception:
        return text


# ba_meta export babase.Plugin
class BMSFingilishPlugin(babase.Plugin):

    def on_app_running(self):
        try:
            import bascenev1 as bs
            self.bs = bs
        except ImportError:
            self.bs = None

        try:
            s = babase.app.config.get(CONFIG_KEY, {})
            if not isinstance(s, dict):
                s = {}
            s.setdefault('enabled', True)
            babase.app.config[CONFIG_KEY] = s
            babase.app.config.commit()
            self.settings = s
        except Exception:
            self.settings = {'enabled': True}

        self._chat_btn = None

        if self.bs:
            self._hook_chat()

        # هوک کردن پنجره‌ی صحیح چت/لابی
        self._hook_party_window()

    def _save(self):
        try:
            babase.app.config[CONFIG_KEY] = self.settings
            babase.app.config.commit()
        except Exception:
            pass

    def _toggle(self):
        self.settings['enabled'] = not self.settings.get('enabled', True)
        self._save()
        on = self.settings['enabled']

        try:
            bui.screenmessage(
                'BMS Fingilish: ' + ('ON' if on else 'OFF'),
                color=(0, 1, 0) if on else (1, 0.4, 0),
            )
        except Exception:
            pass

        if self._chat_btn is not None:
            try:
                bui.buttonwidget(
                    edit=self._chat_btn,
                    label='Fingilish: ' + ('ON' if on else 'OFF'),
                    color=(0.2, 0.7, 0.2) if on else (0.7, 0.2, 0.2),
                )
            except Exception:
                pass

    # ==================== هوک پنجره‌ی چت/لابی (کلاس صحیح) ====================
    def _hook_party_window(self):
        plugin = self
        try:
            # ایمپورت کلاس صحیح از ماژول bauiv1lib.party
            from bauiv1lib.party import PartyWindow
            orig_init = PartyWindow.init

            def new_init(window_self, *args, **kwargs):
                orig_init(window_self, *args, **kwargs)
                try:
                    plugin._add_chat_button(window_self)
                except Exception as e:
                    print('[BMS] add chat button error: ' + str(e))

            PartyWindow.init = new_init
            print('[BMS] PartyWindow hooked successfully')
        except Exception as e:
            print('[BMS] hook PartyWindow failed: ' + str(e))

    def _add_chat_button(self, window):
        """افزودن دکمه روشن/خاموش کنار جعبه ورودی چت"""
        on = self.settings.get('enabled', True)
        try:
            # موقعیت دکمه نسبت به پنجره‌ی PartyWindow
            # این مختصات ممکن است نیاز به تنظیم جزئی داشته باشد
            self._chat_btn = bui.buttonwidget(
                parent=window._root_widget,
                position=(280, 10),  # کنار جعبه ورودی چت
                size=(120, 40),
                label='Fingilish: ' + ('ON' if on else 'OFF'),
                color=(0.2, 0.7, 0.2) if on else (0.7, 0.2, 0.2),
                on_activate_call=self._toggle,
            )
            print('[BMS] Chat button added to PartyWindow')
        except Exception as e:
            print('[BMS] create chat button failed: ' + str(e))

# ==================== هوک چت (برای تبدیل پیام‌ها) ====================
    def _hook_chat(self):
        try:
            if hasattr(self.bs, '_filterChatMessages'):
                self._orig_filter = self.bs._filterChatMessages
                self.bs._filterChatMessages = self._patched_filter
                return
        except Exception:
            pass
        try:
            if hasattr(self.bs, 'chatmessage'):
                self._orig_chat = self.bs.chatmessage
                self.bs.chatmessage = self._patched_chat
        except Exception:
            pass

    def _patched_chat(self, message, *args, **kwargs):
        try:
            if isinstance(message, str):
                cmd = message.strip().lower()
                if cmd == '/fingilish':
                    self._toggle()
                    return
                if cmd == '/fingilish_ui':
                    self._toggle()
                    return
                if self.settings.get('enabled', True):
                    message = to_fingilish(message)
        except Exception:
            pass
        if hasattr(self, '_orig_chat'):
            return self._orig_chat(message, *args, **kwargs)

    def _patched_filter(self, msg, clientID):
        try:
            if isinstance(msg, str):
                cmd = msg.strip().lower()
                if cmd == '/fingilish':
                    self._toggle()
                    return None
                if cmd == '/fingilish_ui':
                    self._toggle()
                    return None
                if self.settings.get('enabled', True):
                    msg = to_fingilish(msg)
        except Exception:
            pass
        if hasattr(self, '_orig_filter'):
            return self._orig_filter(msg, clientID)
        return msg


